{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-YOUR-RAILWAY-URL"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-YOUR-RAILWAY-URL"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "N6NZVZRK2K",
        "appleId": "REPLACE-WITH-ACCOUNT-HOLDER-APPLE-ID",
        "ascAppId": "REPLACE-AFTER-CREATING-THE-APP-RECORD"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    }
  }
}
